# Artify Platform API (Phase 11 — docs/PUBLIC_API_ARCHITECTURE.md in the
# Artify-Backend repo). This is the ONLY backend this site talks to for
# CMS content, the product catalog, and lead submission — see
# src/lib/apiClient.ts and src/lib/publicApi.ts.
#
# Client-exposed (VITE_ vars are bundled into the browser — never put a
# secret here). Required in production; without it the browser falls back
# to this site's own origin at /api/v1, which does not serve the platform's
# public endpoints.
VITE_PLATFORM_API_BASE_URL=https://api.artifysols.com/api/v1

# Server-side only (used by server.ts to build the XML sitemap from real
# published content). Same value as above, without the VITE_ prefix so it
# is never bundled to the client.
PLATFORM_API_BASE_URL=https://api.artifysols.com/api/v1

# Optional — Gemini-backed AI consultant endpoint (server.ts /api/ai-consultant).
# Falls back to a static knowledge base when unset.
GEMINI_API_KEY=
